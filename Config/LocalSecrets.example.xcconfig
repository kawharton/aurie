// TEMPLATE — copy this file to Config/LocalSecrets.xcconfig (gitignored)
// and fill in the values. Never commit the real file.
//
// These are RevenueCat PUBLIC SDK keys (client-facing identifiers). Never
// place secret API keys, App Store Connect keys, or .p8 files anywhere in
// this repository.
//
//   REVENUECAT_TEST_API_KEY        RevenueCat -> Test Store app -> API keys
//   REVENUECAT_PRODUCTION_API_KEY  RevenueCat -> App Store app -> API keys ("appl_...")
//
// Leaving a value empty is SAFE: the app simply reports purchases as
// unavailable for that build configuration instead of failing.

REVENUECAT_TEST_API_KEY =
REVENUECAT_PRODUCTION_API_KEY =
